<?xml version="1.0" encoding="utf-8"?>
<!-- No touchscreen on this device, so scrolling has to work via the
     hardware D-pad, not swipe — a plain ScrollView handles that for free:
     Buttons are focusable, so DPAD up/down already moves focus between
     them by default, and ScrollView auto-scrolls to keep whichever one is
     currently focused on screen. No custom key handling needed here,
     unlike TurboText's row-highlight screens (those use plain TextViews,
     which aren't focusable, so they have to fake it manually). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/openAccessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Accessibility Settings"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/openOverlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Overlay Permission Settings"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/requestMicButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Microphone Permission"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/requestStorageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Storage Access"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/requestSmsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant SMS Permission (optional)"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/setTrustedNumberButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Trusted Provisioning Number" />

    </LinearLayout>

</ScrollView>
