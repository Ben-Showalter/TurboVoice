<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- For reading the Groq API key from Internal storage/Turbo Key/groq_api_key.txt.
         MANAGE_EXTERNAL_STORAGE ("All files access") is what's actually needed on
         API 30+ to reach an arbitrary top-level folder like this under scoped
         storage; the other two cover the runtime-permission model on API 24-29. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Optional: lets the Groq API key be set remotely via a
         specially-formatted text (see ApiKeyProvisioningHelper), same
         idea as TurboText's own provisioning texts. This does NOT make
         TurboVoice a messaging app or a default-SMS-app candidate — it
         just reads a copy of each incoming message alongside whatever
         app actually handles SMS on this device. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_square"
        android:label="@string/app_name"
        android:theme="@style/Theme.TurboVoice"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TurboVoiceAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- android:permission restricts who's allowed to send this
             broadcast to the system itself, so another app can't spoof a
             fake incoming text to trigger provisioning. exported="true" is
             required for the system to be able to deliver it at all. -->
        <receiver
            android:name=".ProvisioningSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
